# Copy to .env.local and fill in (or to .env for the local server). Non-secrets
# keep real values; secrets use placeholders here — set the real ones in
# .env.local (gitignored) and in Vercel. Unset vars fall back to defaults in
# src/site.config.ts, so the site runs with none of these set.
# Convention: NEXT_PUBLIC_<PLATFORM>_<PURPOSE> for public (client-inlined)
# values; no prefix for server-only secrets.

# ============================================
# BUILD / RUNTIME
# ============================================
# Set on Preview + Staging (every route reachable, noindexed); unset on Production.
# NEXT_PUBLIC_DEV_MODE=true

# ============================================
# LINKS / SOCIAL  (public)
# ============================================
# Discord — general invite is the fallback wherever a page declares no specific
# link. Pages/blocks reference a channel by key (e.g. `discord: research`), a
# full URL, or omit it. Keys map to the channel vars below.
NEXT_PUBLIC_DISCORD_INVITE=https://discord.gg/2V8DuCeBWz
NEXT_PUBLIC_DISCORD_RESEARCH=https://discord.gg/8asdWDW5QY
NEXT_PUBLIC_DISCORD_CALLS=https://discord.gg/Zes4pNuCPb
NEXT_PUBLIC_DISCORD_THINKING=https://discord.gg/eRHtnj7nhw
NEXT_PUBLIC_DISCORD_RESOURCES=https://discord.gg/h5Fh3Pzq26
# GitHub — the org landing page.
NEXT_PUBLIC_GITHUB_ORG=https://github.com/co-goods

# ============================================
# EMAIL / MESSAGING
# ============================================
# SendGrid — newsletter signup. API key is secret; the list id is config.
SENDGRID_API_KEY=your_sendgrid_api_key          # secret
SENDGRID_LIST_COGOODS=your_sendgrid_list_id

# ============================================
# ANALYTICS  (public)
# ============================================
# Google Analytics measurement ID. Not set up for Co-Goods yet — uncomment when
# a GA property exists. Unset = no analytics script rendered.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ============================================
# TOKENS / SECRETS  (server-only)
# ============================================
# GitHub PAT used by vercel-install.sh to fetch the cross-org grund submodule
# during the build. Server-only — never NEXT_PUBLIC_.
GRUND_TOKEN=your_github_pat                       # secret
